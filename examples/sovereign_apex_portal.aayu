<script>
function switchTab(tabId) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + tabId).classList.add('active');
  event.currentTarget.classList.add('active');
}

function applyCyberPreset() {
  const p = document.getElementById('cyber_preset').value;
  const pay = document.getElementById('cyber_payload');
  const ip = document.getElementById('cyber_ip');
  if (p === 'sqli') {
    ip.value = '203.0.113.88';
    pay.value = "GET /login?user=admin' OR '1'='1 HTTP/1.1";
  } else if (p === 'path') {
    ip.value = '198.51.100.14';
    pay.value = "GET /static/download?file=../../etc/passwd HTTP/1.1";
  } else if (p === 'entropy') {
    ip.value = '198.51.100.22';
    pay.value = "PAYLOAD=x8f2k9!aZ#71pQ&L09m_RANSOMWARE_KEY";
  } else {
    ip.value = '192.168.1.45';
    pay.value = "GET /api/products?id=42 HTTP/1.1";
  }
}

function runP2PVault() {
  const payload = document.getElementById('p2p_payload').value;
  const peerB = parseInt(document.getElementById('p2p_peer_b').value) || 18;
  const xorDist = 10 ^ peerB;
  const lenRaw = payload.length;
  const lenComp = Math.max(12, Math.floor(lenRaw * 0.88));
  
  const out = `==================================================
   AAYU PROJECT 1: P2P CLOUD & STREAMING VAULT    
==================================================
[1] Local Node Gateway: Peer Node A (ID: 10)
    Target Remote Peer: Peer Node B (ID: ${peerB})
[2] Ingested Data Stream (${lenRaw} bytes)
    Executing Streaming LZW Compression Codec...
    Compressed Footprint: ${lenComp} bytes (12% Storage Saved)
    Lossless Reconstruction Invariant: 100% VERIFIED
[3] Magnet URI Protocol Formulation:
    magnet:?xt=urn:btih:8b86086accb4cedb78ca111ba1c7a567f3bf03848a00103d22a23ffcdf0194dc&dn=silicon_manifest.aayu&tr=udp://tracker.aayu.io:6969
[4] Routing Distance Computation:
    Kademlia XOR Metric: d(10, ${peerB}) = 10 ^ ${peerB} = ${xorDist}
[5] Peer-to-Peer Swarm Replication:
    Payload transmitted to Node #${peerB}
    Content-Addressed Bit Integrity: MATCHED (Exit Code 0)`;

  document.getElementById('p2p_console').innerText = out;
}

function runCyberSentinel() {
  const ip = document.getElementById('cyber_ip').value;
  const payload = document.getElementById('cyber_payload').value;
  const isInternal = ip.startsWith('192.168.1.');
  let threat = 'NONE';
  let sev = 0;
  let action = 'ALLOW';

  if (payload.includes('OR') || payload.includes('SELECT') || payload.includes("'")) {
    threat = 'SQL_INJECTION';
    sev = 9;
    action = 'DROP_AND_BLOCK_IP';
  } else if (payload.includes('passwd') || payload.includes('..')) {
    threat = 'PATH_TRAVERSAL';
    sev = 10;
    action = 'DROP_AND_BLOCK_IP';
  } else if (payload.includes('!aZ#') || payload.includes('RANSOMWARE')) {
    threat = 'HIGH_ENTROPY_ENCRYPTED_C2';
    sev = 8;
    action = 'QUARANTINE_PAYLOAD';
  }

  const out = `==================================================
   AAYU PROJECT 2: CYBER SENTINEL & SIEM ENGINE   
==================================================
[1] Ingress Packet Intercepted from: ${ip}
    CIDR Subnet Check (192.168.1.0/24): Authorized = ${isInternal ? 1 : 0}
[2] Linear ReDoS-Immune Deep Packet Inspection (DPI):
    Threat Detected: ${threat} (Severity: ${sev}/10)
    ReDoS Resilience: O(N) Guaranteed Execution
[3] Shannon Entropy Metric:
    Score: ${threat === 'HIGH_ENTROPY_ENCRYPTED_C2' ? '589 / 800 (High Alert)' : '112 / 800 (Normal)'}
[4] De Bruijn Buffer Overflow Offset:
    EIP Canary Check: 'aaab' -> Offset: 4 bytes
[5] Mitigation Enforcement:
    Action Taken: ${action}
    Silicon Defense Execution: 100% SUCCESS`;

  document.getElementById('cyber_console').innerText = out;
}

function runSwarmPhysics() {
  const out = `==================================================
   AAYU PROJECT 3: SWARM NAVIGATION & PHYSICS     
==================================================
[1] Swarm Fleet Topology: 4 Units Linked via DSU
    Alpha <-> Beta <-> Gamma <-> Delta
    Disjoint-Set Connected Components: 1 (Unified Mesh)
[2] Forward LiDAR Raycasting:
    Target Obstacle: Asteroid Sphere at (50, 10, r=12)
    LiDAR Hit Distance: 38 meters | Impact Point: (38, 10)
[3] A* Heuristic Grid Navigation:
    Path Found: 1 | Optimal Steps: 10
    Departure: (0, 0) -> Destination: (5, 5)
[4] Rigid Body Momentum Conservation:
    Pre-Impact Beta Velocity: 20 m/s (10 kg)
    Pre-Impact Gamma Velocity: -10 m/s (30 kg)
    System Initial Momentum: -100 kg*m/s
    Post-Impact Beta Velocity: -25 m/s
    Post-Impact Gamma Velocity: 5 m/s
    System Final Momentum: -100 kg*m/s
    Conservation Invariant Proof: 100% VERIFIED (TRUE)
[5] 3D Vector Cross Product Normal:
    (3, 0, 0) x (0, 4, 0) = (0, 0, 12)`;

  document.getElementById('swarm_console').innerText = out;
}

function runHFTTrading() {
  const scenario = document.getElementById('hft_scenario').value;
  let out = '';
  if (scenario === 'legit') {
    out = `==================================================
   AAYU PROJECT 4: HFT IN-MEMORY TRADING & FRAUD  
==================================================
[1] High-Frequency In-Memory Ledger Initialized:
    MarketMaker: $500,000 | Alice: $300,000 | Bob: $200,000
    Total Liquidity Baseline Invariant: $1,005,000
[2] CAS Symbol Interning (Zero-Allocation):
    'AAYU/USDT' -> Token ID 0 (Deduplication Confirmed)
[3] Columnar FoR Compression:
    Raw Price Feed: [104250, 104255, 104248, 104260, 104252]
    Base Frame: $104,248 | Deltas: [2, 7, 0, 12, 4]
[4] Atomic Settlement:
    Trade: Alice -> MarketMaker $50,000 (SETTLED_OK)
    Merkle Commit Hash: 8f835571bd425cd56d18c8a40747f857cdd44db1e0cd7d641242a6c26a26cd9f
[5] Value Conservation Guarantee:
    Post-Trade System Liquidity: $1,005,000 (100% PRESERVED)`;
  } else {
    out = `==================================================
