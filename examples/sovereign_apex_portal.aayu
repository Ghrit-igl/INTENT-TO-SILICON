          <option value="sqli">Malicious SQL Injection (admin' OR '1'='1)</option>
          <option value="path">Path Traversal Attack (../../etc/passwd)</option>
          <option value="entropy">High-Entropy Encrypted C2 Payload (x8f2k9!aZ#71pQ&L09m)</option>
          <option value="safe">Safe Internal Request (GET /api/products?id=42)</option>
        </select>

        <label>Raw Ingress Packet Content:</label>
        <textarea id="cyber_payload" rows="3">GET /login?user=admin' OR '1'='1 HTTP/1.1</textarea>

        <button onclick="runCyberSentinel()" class="btn-run" style="background:#ef4444; color:#fff;">🛡️ Fire Packet at Sentinel</button>
      </div>

      <div class="card">
