</div>

<script>
function switchTab(tabId) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  document.getElementById('tab-' + tabId).classList.add('active');
  event.currentTarget.classList.add('active');
}

function applyCyberPreset() {
  const p = document.getElementById('cyber_preset').value;
  const pay = document.getElementById('cyber_payload');
  const ip = document.getElementById('cyber_ip');
  if (p === 'sqli') {
    ip.value = '203.0.113.88';
    pay.value = "GET /login?user=admin' OR '1'='1 HTTP/1.1";
  } else if (p === 'path') {
    ip.value = '198.51.100.14';
    pay.value = "GET /static/download?file=../../etc/passwd HTTP/1.1";
  } else if (p === 'entropy') {
    ip.value = '198.51.100.22';
    pay.value = "PAYLOAD=x8f2k9!aZ#71pQ&L09m_RANSOMWARE_KEY";
  } else {
    ip.value = '192.168.1.45';
    pay.value = "GET /api/products?id=42 HTTP/1.1";
  }
}

async function runP2PVault() {
  const payload = document.getElementById('p2p_payload').value;
  const peerB = parseInt(document.getElementById('p2p_peer_b').value) || 18;
  const consoleEl = document.getElementById('p2p_console');
  consoleEl.innerText = "[DISPATCHING] Transmitting payload to AAYU Silicon P2P Node on localhost:8080...";
  
  try {
    const res = await fetch('/api/p2p/store', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ payload: payload, peer_id: peerB, filename: "silicon_manifest.aayu" })
    });
    const d = await res.json();
    consoleEl.innerText = `==================================================
   AAYU PROJECT 1: P2P CLOUD & STREAMING VAULT    
==================================================
[1] Local Gateway Node: Peer #${d.gateway_node} (Online)
    Target Remote Peer: Peer #${d.target_peer}
[2] Stream Compression Codec:
    Original Size: ${d.raw_bytes} bytes -> Compressed: ${d.compressed_bytes} bytes
    Compression Savings: ${d.compression_ratio}
    Lossless Integrity Verified: ${d.lossless_verified ? "1 (100% BIT-EXACT)" : "0"}
[3] BitTorrent Magnet URI Protocol:
    ${d.magnet_uri}
[4] Routing Distance Computation:
    Kademlia XOR Metric: d(${d.gateway_node}, ${d.target_peer}) = ${d.xor_distance}
[5] Swarm Replication Status:
    Transmitted & Replicated to Peer #${d.target_peer}
    SHA-256 InfoHash: ${d.sha256_hash}
    Hardware Latency: ${d.latency_us} µs
==================================================
   PROJECT 1: P2P VAULT EXECUTION SUCCESSFUL!     
==================================================`;
  } catch (err) {
    consoleEl.innerText = "[ERROR] P2P Node error: " + err;
  }
}

async function runCyberSentinel() {
  const ip = document.getElementById('cyber_ip').value;
  const payload = document.getElementById('cyber_payload').value;
  const consoleEl = document.getElementById('cyber_console');
  consoleEl.innerText = "[ARMED] Inspecting packet at wire speed through ReDoS DPI...";

  try {
    const res = await fetch('/api/cyber/inspect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ip: ip, payload: payload })
    });
    const d = await res.json();
    consoleEl.innerText = `==================================================
   AAYU PROJECT 2: CYBER SENTINEL & SIEM ENGINE   
==================================================
[1] Packet Ingress from: ${d.source_ip}
    CIDR Subnet Check (192.168.1.0/24): Authorized = ${d.trusted_subnet ? 1 : 0}
[2] Linear ReDoS-Immune Deep Packet Inspection (DPI):
    Threat Detected: ${d.threat} (Severity: ${d.severity}/10)
    Algorithmic Resilience: O(N) Guaranteed Linear Time
[3] Shannon Entropy Metric:
    Score: ${d.shannon_entropy} ${d.threat === 'HIGH_ENTROPY_ENCRYPTED_C2' ? '(HIGH ENCRYPTED ALERT)' : '(NORMAL)'}
[4] De Bruijn Buffer Overflow Canary:
    Intercepted EIP Register: '${d.canary_register}'
    Exact Stack Canary Offset: ${d.canary_offset} bytes
[5] Autonomous Mitigation Decision:
    Action Taken: ${d.action}
    Audit SHA-256: ${d.audit_hash}
    Hardware Defense Latency: ${d.latency_us} µs
==================================================
   PROJECT 2: CYBER SENTINEL EXECUTION SUCCESS!   
==================================================`;
  } catch (err) {
    consoleEl.innerText = "[ERROR] Sentinel error: " + err;
  }
}

async function runSwarmPhysics() {
  const consoleEl = document.getElementById('swarm_console');
  consoleEl.innerText = "[COMPUTING] Simulating 4-drone DSU mesh, LiDAR raycast & momentum collision...";

  try {
    const res = await fetch('/api/swarm/navigate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ m1: 10, v1: 20, m2: 30, v2: -10 })
    });
    const d = await res.json();
    consoleEl.innerText = `==================================================
   AAYU PROJECT 3: SWARM NAVIGATION & PHYSICS     
==================================================
[1] Swarm Fleet Topology: 4 Units Linked via DSU
    Alpha <-> Beta <-> Gamma <-> Delta
    Disjoint-Set Connected Components: ${d.dsu_components} (Unified Mesh)
    Full Mesh Interconnect: ${d.mesh_connected ? 1 : 0}
[2] Forward LiDAR Raycasting:
    Target Obstacle: Asteroid Sphere at (50, 10, r=12)
    LiDAR Hit Distance: ${d.lidar_hit_m} meters | Impact Point: (${d.lidar_point[0]}, ${d.lidar_point[1]})
[3] A* Heuristic Grid Navigation:
    Path Found: 1 | Waypoints: ${d.astar_waypoints} | Optimal Steps: ${d.astar_steps}
    Departure: (${d.departure[0]}, ${d.departure[1]}) -> Destination: (${d.destination[0]}, ${d.destination[1]})
[4] Rigid Body Momentum Conservation:
    Pre-Impact Beta Velocity: ${d.pre_impact_beta_v} m/s (10 kg)
    Pre-Impact Gamma Velocity: ${d.pre_impact_gamma_v} m/s (30 kg)
    System Initial Momentum: ${d.initial_momentum} kg*m/s
    Post-Impact Beta Velocity: ${d.post_impact_beta_v} m/s
    Post-Impact Gamma Velocity: ${d.post_impact_gamma_v} m/s
    System Final Momentum: ${d.final_momentum} kg*m/s
    Conservation Invariant Proof: ${d.momentum_conserved ? "100% VERIFIED (Invariant Holds)" : "ERROR"}
[5] 3D Vector Cross Product Normal:
