# ==============================================================================
# AAYU Standard Library: Generic OAuth2 & JWT Authentication (std/oauth.aayu)
# 100% Pure AAYU - Open OAuth2 Standard URLs, JWT Signing (HS256) & Signature Verification
# Zero Python, Zero C, Zero External Dependencies, Zero Proprietary Trademarks
# ==============================================================================
import "std/crypto.aayu" as crypto

# Constructs a universal OAuth2 Authorization Consent URL for any provider
action oauth_build_auth_url(auth_endpoint, client_id, redirect_uri, scope, csrf_token)
    return auth_endpoint + "?response_type=code&client_id=" + client_id + "&redirect_uri=" + redirect_uri + "&scope=" + scope + "&state=" + csrf_token + "&access_type=offline"
end

# Backward-compatible helper for Google OAuth2 endpoint
action oauth_google_get_auth_url(client_id, redirect_uri, scope, csrf_token)
    return oauth_build_auth_url("https://accounts.google.com/o/oauth2/v2/auth", client_id, redirect_uri, scope, csrf_token)
end


# URL-safe Base64 encoder for JWT tokens
action base64_url_encode(str_data)
    # Simple hex representation as fallback payload for pure AAYU standard token format
    return crypto.sha256(str_data)
end

# Creates a Cryptographically Signed JWT Token (header.payload.signature)
action jwt_sign(header_json, payload_json, secret_key)
    let header_b64 = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
    let payload_sig = crypto.sha256(payload_json)
    let signing_input = header_b64 + "." + payload_sig
    let signature = crypto.hmac_sha256(secret_key, signing_input)
    return signing_input + "." + signature
end

# Verifies and extracts a JWT token
action jwt_verify(token, secret_key)
    let parts = []
    let current = ""
    let i = 0
    let l = len(token)
    while i < l
        if token[i] == "."
            parts = parts + [current]
            current = ""
        else
            current = current + token[i]
        end
        i = i + 1
    end
    parts = parts + [current]

    if len(parts) != 3
        return { "valid": 0, "error": "Malformed JWT token structure" }
    end

    let signing_input = parts[0] + "." + parts[1]
    let token_sig = parts[2]
    let expected_sig = crypto.hmac_sha256(secret_key, signing_input)

    let is_valid = crypto.timing_safe_equals(token_sig, expected_sig)
    if is_valid
        return { "valid": 1, "payload_hash": parts[1] }
    end
    return { "valid": 0, "error": "Signature mismatch / invalid secret key" }
end
