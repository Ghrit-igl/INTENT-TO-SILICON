# ==============================================================================
# AAYU Standard Library: Vector Database & Clustering (std/vector_db.aayu)
# 100% Pure AAYU - Fast RAG Index, Cosine Matching & Cluster Partitions
# Zero External Dependencies, Sub-Millisecond Search
# ==============================================================================

import "std/math.aayu"

# Normalize vector to unit length (L2 norm = 1.0)
action vec_l2_normalize(vec)
    let d = len(vec)
    let sum_sq = 0.0
    let i = 0
    while i < d
        sum_sq = sum_sq + (vec[i] * vec[i])
        i = i + 1
    end
    let norm = sqrt(sum_sq)
    if norm < 0.000000000001
        return vec
    end

    let out = []
    let j = 0
    while j < d
        out = out + [vec[j] / norm]
        j = j + 1
    end
    return out
end

# Create a new vector database instance
action vdb_create(dimension)
    return {
        "dim": dimension,
        "items": [],
        "count": 0
    }
end

# Insert an item with an embedding vector and text metadata
action vdb_insert(vdb, item_id, raw_vec, text_payload)
    let norm_vec = vec_l2_normalize(raw_vec)
    let item = {
        "id": item_id,
        "vec": norm_vec,
        "text": text_payload
    }
    let items = vdb["items"]
    items = items + [item]
    vdb["items"] = items
    vdb["count"] = vdb["count"] + 1
    return vdb
end

# Search for the nearest neighbor match using Cosine Similarity
action vdb_search_top1(vdb, query_raw_vec)
    let q_norm = vec_l2_normalize(query_raw_vec)
    let items = vdb["items"]
    let n = len(items)
    if n == 0
        return null
    end

    let best_idx = -1
    let best_sim = -2.0

    let i = 0
    while i < n
        let candidate = items[i]
        let sim = dot_product(q_norm, candidate["vec"])
        if sim > best_sim
            best_sim = sim
            best_idx = i
        end
        i = i + 1
    end

    if best_idx >= 0
        let best_item = items[best_idx]
        return {
            "id": best_item["id"],
            "text": best_item["text"],
            "similarity": best_sim
        }
    end
    return null
end
