# ==============================================================================
# AAYU Standard Library: Intent Engine (std/intent.aayu)
# 100% Pure Self-Hosted AAYU (.aayu)
# Bridging Human/AI Intent Directly to Silicon Bytecode Verification
# ==============================================================================
import "std/crypto.aayu"
import "std/contracts.aayu"

# Creates a new structured intent declaration
action create_intent(intent_id, goal_description, author)
    return {
        "id": intent_id,
        "goal": goal_description,
        "author": author,
        "constraints": [],
        "invariants": [],
        "preconditions": [],
        "postconditions": [],
        "is_locked": 0,
        "seal_hash": "UNLOCKED"
    }
end

# Adds an execution constraint to an intent
action intent_add_constraint(intent_obj, constraint_id, constraint_desc)
    if intent_obj["is_locked"] == 1
        print("[INTENT ERROR] Cannot modify locked intent: " + intent_obj["id"])
        return intent_obj
    end
    let cur = intent_obj["constraints"]
    let updated = cur + [{
        "id": constraint_id,
        "description": constraint_desc
    }]
    intent_obj["constraints"] = updated
    return intent_obj
end

# Adds a mathematical or logical invariant that must hold continuously
action intent_add_invariant(intent_obj, invariant_id, invariant_desc)
    if intent_obj["is_locked"] == 1
        print("[INTENT ERROR] Cannot modify locked intent: " + intent_obj["id"])
        return intent_obj
    end
    let cur = intent_obj["invariants"]
    let updated = cur + [{
        "id": invariant_id,
        "description": invariant_desc
    }]
    intent_obj["invariants"] = updated
    return intent_obj
end

# Adds a pre-condition that must be met before execution starts
action intent_add_precondition(intent_obj, pre_id, pre_desc)
    if intent_obj["is_locked"] == 1
        print("[INTENT ERROR] Cannot modify locked intent: " + intent_obj["id"])
        return intent_obj
    end
    let cur = intent_obj["preconditions"]
    let updated = cur + [{
        "id": pre_id,
        "description": pre_desc
    }]
    intent_obj["preconditions"] = updated
    return intent_obj
end

# Adds a post-condition that must be verified upon completion
action intent_add_postcondition(intent_obj, post_id, post_desc)
    if intent_obj["is_locked"] == 1
        print("[INTENT ERROR] Cannot modify locked intent: " + intent_obj["id"])
        return intent_obj
    end
    let cur = intent_obj["postconditions"]
    let updated = cur + [{
        "id": post_id,
        "description": post_desc
    }]
    intent_obj["postconditions"] = updated
    return intent_obj
end

# Cryptographically locks the intent with SHA-256 seal
# Once locked, the intent is immutable and ready for silicon verification
action intent_lock(intent_obj)
    let payload = intent_obj["id"] + ":" + intent_obj["goal"] + ":" + intent_obj["author"]
    
    # Serialize constraints
    let c = intent_obj["constraints"]
    let ci = 0
    while ci < len(c)
        payload = payload + ";C:" + c[ci]["id"] + "=" + c[ci]["description"]
        ci = ci + 1
    end

    # Serialize invariants
    let inv = intent_obj["invariants"]
    let invi = 0
    while invi < len(inv)
        payload = payload + ";I:" + inv[invi]["id"] + "=" + inv[invi]["description"]
        invi = invi + 1
    end

    let seal = hash_string("AAYU_INTENT_SEAL_V1:" + payload)
    intent_obj["is_locked"] = 1
    intent_obj["seal_hash"] = seal
    return intent_obj
end

# Verifies that execution results satisfy the locked intent contract
action intent_verify_execution(locked_intent, results_dict)
    if locked_intent["is_locked"] != 1
        return {
            "verified": 0,
            "error": "Intent is not cryptographically locked."
        }
    end

    let violations = []

    # Check that required output keys exist
    if results_dict["status"] != "SUCCESS"
        violations = violations + ["Execution status is not SUCCESS"]
    end

    let is_ok = len(violations) == 0
    return {
        "verified": is_ok,
        "intent_id": locked_intent["id"],
        "seal_hash": locked_intent["seal_hash"],
        "violations": violations
    }
end

# Generates verifiable intent traceability artifact
action intent_generate_traceability_report(locked_intent, execution_proof)
    return {
        "intent_id": locked_intent["id"],
        "goal": locked_intent["goal"],
        "author": locked_intent["author"],
        "cryptographic_seal": locked_intent["seal_hash"],
        "constraints_count": len(locked_intent["constraints"]),
        "invariants_count": len(locked_intent["invariants"]),
        "execution_verified": execution_proof["verified"],
        "verified_on": "AAYU Silicon VM Native Engine"
    }
end
