# ==============================================================================
# AAYU Standard Library: Universal Cloud Object Storage (std/cloud_storage.aayu)
# 100% Pure AAYU - Standardized Signature Version 4 (SigV4) Signing & Storage Protocol
# Compatible with MinIO, Ceph, Cloudflare R2, AWS, Backblaze B2, and OpenStack
# Zero Python, Zero C, Zero External Dependencies, Zero Proprietary Trademarks
# ==============================================================================
import "std/crypto.aayu" as crypto

# Initializes a cloud object storage client
action storage_client(access_key, secret_key, region, bucket, endpoint_host)
    return {
        "access_key": access_key,
        "secret_key": secret_key,
        "region": region,
        "bucket": bucket,
        "host": endpoint_host,
        "endpoint": "https://" + endpoint_host
    }
end

# Generates standard SigV4 Signing Key: HMAC(HMAC(HMAC(HMAC("AWS4" + kSecret, date), region), service), "aws4_request")
action storage_get_signature_key(secret_key, date_stamp, region, service)
    let k_secret = "AWS4" + secret_key
    let k_date = crypto.hmac_sha256(k_secret, date_stamp)
    let k_region = crypto.hmac_sha256(k_date, region)
    let k_service = crypto.hmac_sha256(k_region, service)
    let k_signing = crypto.hmac_sha256(k_service, "aws4_request")
    return k_signing
end

# Constructs complete SigV4 Authorization Header for Cloud Object Storage
action storage_create_authorization(client, method, canonical_uri, payload, date_stamp, amz_date)
    let payload_hash = crypto.sha256(payload)
    let canonical_headers = "host:" + client["host"] + "\nx-amz-date:" + amz_date + "\n"
    let signed_headers = "host;x-amz-date"
    let canonical_request = method + "\n" + canonical_uri + "\n\n" + canonical_headers + "\n" + signed_headers + "\n" + payload_hash

    let credential_scope = date_stamp + "/" + client["region"] + "/s3/aws4_request"
    let string_to_sign = "AWS4-HMAC-SHA256\n" + amz_date + "\n" + credential_scope + "\n" + crypto.sha256(canonical_request)

    let signing_key = storage_get_signature_key(client["secret_key"], date_stamp, client["region"], "s3")
    let signature = crypto.hmac_sha256(signing_key, string_to_sign)

    let auth_header = "AWS4-HMAC-SHA256 Credential=" + client["access_key"] + "/" + credential_scope + ", SignedHeaders=" + signed_headers + ", Signature=" + signature
    return {
        "authorization": auth_header,
        "x-amz-date": amz_date,
        "x-amz-content-sha256": payload_hash,
        "signature": signature
    }
end
