# ==============================================================================
# AAYU Master Advanced Engine Test Suite
# Tests:
#   1. Fault-Tolerant Actor Concurrency & CSP Channels (std/actor.aayu)
#   2. High-Speed Binary Codec, Varint & Framed Wire Protocol (std/binary.aayu)
#   3. Zero-Knowledge Proofs & Shamir Threshold Cryptography (std/zkp.aayu)
# ==============================================================================
import "std/test.aayu"
import "std/actor.aayu"
import "std/binary.aayu"
import "std/zkp.aayu"

test_begin_suite("AAYU Advanced Engine Suite: Actors, Binary Wire & ZKP")

# ------------------------------------------------------------------------------
# PART 1: GO-STYLE CHANNELS & ERLANG-STYLE ACTORS & SUPERVISORS
# ------------------------------------------------------------------------------
print("\n[Phase 1] Testing CSP Channels (Buffered Queue & Backpressure)...")

let ch = channel_new(3)
assert_eq(channel_len(ch), 0, "Channel is initially empty")
assert_true(channel_is_empty(ch), "channel_is_empty returns 1")

let ok1 = channel_send(ch, 10)
let ok2 = channel_send(ch, 20)
let ok3 = channel_send(ch, 30)
assert_eq(ok1, 1, "First item sent to channel")
assert_eq(ok2, 1, "Second item sent to channel")
assert_eq(ok3, 1, "Third item sent to channel")
assert_true(channel_is_full(ch), "Channel is full at capacity 3")

# Fourth send should fail due to backpressure capacity limit
let ok4 = channel_send(ch, 40)
assert_eq(ok4, 0, "Channel backpressure rejected item when full")

# FIFO receive
let r1 = channel_recv(ch)
assert_eq(r1, 10, "FIFO popped item 1 (10)")
let r2 = channel_recv(ch)
assert_eq(r2, 20, "FIFO popped item 2 (20)")
let r3 = channel_recv(ch)
assert_eq(r3, 30, "FIFO popped item 3 (30)")
assert_true(channel_is_empty(ch), "Channel is empty after draining")

print("\n[Phase 2] Testing Channel Select Multiplexer...")
let chA = channel_new(2)
let chB = channel_new(2)
channel_send(chB, 999) # Send only to channel B

let sel = channel_select([chA, chB])
assert_eq(sel["has_data"], 1, "Channel select found available data")
assert_eq(sel["selected_channel_index"], 1, "Selected channel index is 1 (channel B)")
assert_eq(sel["value"], 999, "Received correct value from selected channel")

print("\n[Phase 3] Testing Erlang-Style Actor Mailboxes & Isolated State...")
let act_sys = actor_system_new()
let a1 = actor_spawn(act_sys, "worker_alpha", { "processed": 0 })
let a2 = actor_spawn(act_sys, "worker_beta", { "processed": 0 })

# Asynchronously send messages
actor_send(act_sys, "worker_alpha", "TASK_INIT")
actor_send(act_sys, "worker_alpha", "TASK_EXEC")
actor_send(act_sys, "worker_beta", "TASK_PING")

assert_eq(actor_mailbox_len(act_sys, "worker_alpha"), 2, "worker_alpha has 2 queued messages")
assert_eq(actor_mailbox_len(act_sys, "worker_beta"), 1, "worker_beta has 1 queued message")

# Process worker alpha mailbox
let m1 = actor_receive_one(act_sys, "worker_alpha")
assert_eq(m1, "TASK_INIT", "Worker alpha received first task")
let remaining = actor_drain_mailbox(act_sys, "worker_alpha")
assert_eq(len(remaining), 1, "Drained 1 remaining task")
assert_eq(remaining[0], "TASK_EXEC", "Task matches TASK_EXEC")
assert_eq(actor_mailbox_len(act_sys, "worker_alpha"), 0, "Mailbox empty after drain")

# Mutate isolated actor state
actor_set_state(act_sys, "worker_alpha", { "processed": 2 })
let st_a = actor_get_state(act_sys, "worker_alpha")
assert_eq(st_a["processed"], 2, "Actor state isolated and updated")

print("\n[Phase 4] Testing Erlang-Style Fault-Tolerant Supervisors...")
# Test ONE_FOR_ONE supervisor strategy
let sup1 = supervisor_new("ONE_FOR_ONE", 3)
supervisor_register_worker(sup1, "db_worker", { "connected": 1 })
supervisor_register_worker(sup1, "api_worker", { "connected": 1 })

# Simulate crash on db_worker
let sup_ok = supervisor_notify_crash(sup1, "db_worker")
assert_eq(sup_ok, 1, "Supervisor handled worker crash successfully")
assert_eq(supervisor_get_restart_count(sup1, "db_worker"), 1, "db_worker restart count incremented to 1")
assert_eq(supervisor_get_restart_count(sup1, "api_worker"), 0, "api_worker untouched under ONE_FOR_ONE")

# Test ONE_FOR_ALL supervisor strategy
let sup_all = supervisor_new("ONE_FOR_ALL", 3)
supervisor_register_worker(sup_all, "cache_worker", { "uptime": 100 })
supervisor_register_worker(sup_all, "queue_worker", { "uptime": 100 })

supervisor_notify_crash(sup_all, "cache_worker")
assert_eq(supervisor_get_restart_count(sup_all, "cache_worker"), 1, "cache_worker restarted")
assert_eq(supervisor_get_restart_count(sup_all, "queue_worker"), 1, "queue_worker also restarted under ONE_FOR_ALL")

# ------------------------------------------------------------------------------
# PART 2: SILICON BINARY CODEC, VARINT & WIRE PROTOCOL
# ------------------------------------------------------------------------------
print("\n[Phase 5] Testing Protobuf-Style Varint (LEB128) & ZigZag Encoding...")

# 1-byte Varint: 127
let v127 = bin_encode_varint(127)
assert_eq(len(v127), 1, "127 fits in 1 byte")
assert_eq(v127[0], 127, "Byte value is 127")
let d127 = bin_decode_varint(v127, 0)
assert_eq(d127["value"], 127, "Decoded value is 127")
assert_eq(d127["bytes_read"], 1, "1 byte read")

# Multi-byte Varint: 300 (0x12C = 0xAC 0x02)
let v300 = bin_encode_varint(300)
assert_eq(len(v300), 2, "300 takes 2 bytes in LEB128")
let d300 = bin_decode_varint(v300, 0)
assert_eq(d300["value"], 300, "Decoded value is 300")
assert_eq(d300["bytes_read"], 2, "2 bytes read")

# Large Varint: 1,000,000
let v1m = bin_encode_varint(1000000)
let d1m = bin_decode_varint(v1m, 0)
assert_eq(d1m["value"], 1000000, "Decoded 1,000,000 cleanly")

# ZigZag Encoding tests:
assert_eq(bin_zigzag_encode(0), 0, "ZigZag(0) = 0")
assert_eq(bin_zigzag_encode(-1), 1, "ZigZag(-1) = 1")
assert_eq(bin_zigzag_encode(1), 2, "ZigZag(1) = 2")
assert_eq(bin_zigzag_encode(-2), 3, "ZigZag(-2) = 3")
assert_eq(bin_zigzag_encode(2), 4, "ZigZag(2) = 4")

# ZigZag Round-Trip with Varint for negative numbers
let enc_neg = bin_encode_signed_varint(-42)
let dec_neg = bin_decode_signed_varint(enc_neg, 0)
assert_eq(dec_neg["value"], -42, "Signed varint round-trip for -42 verified")

print("\n[Phase 6] Testing Packet Framing & CRC16 Integrity Verification...")
let test_payload = [10, 20, 30, 40, 50]
let framed = bin_frame_packet(1, test_payload)
# Header: 2 magic + 1 type + 2 len = 5 bytes. Payload: 5 bytes. CRC: 2 bytes. Total: 12 bytes.
assert_eq(len(framed), 12, "Framed packet length is 12 bytes")
assert_eq(framed[0], 170, "Magic byte 0 is 0xAA (170)")
assert_eq(framed[1], 85, "Magic byte 1 is 0x55 (85)")

let verified = bin_verify_frame(framed)
assert_eq(verified["valid"], 1, "Packet frame verified valid")
assert_eq(verified["msg_type"], 1, "Message type is 1")
assert_eq(len(verified["payload"]), 5, "Payload length is 5")

# Test corruption detection: flip a byte in payload
let corrupted = []
let idx = 0
while idx < len(framed)
    if idx == 6
        corrupted = corrupted + [(framed[idx] + 1) % 256] # Corrupt payload byte
    else
        corrupted = corrupted + [framed[idx]]
    end
    idx = idx + 1
end

let corrupt_check = bin_verify_frame(corrupted)
assert_eq(corrupt_check["valid"], 0, "Corrupted packet rejected by CRC16")
assert_eq(corrupt_check["error"], "CRC_CORRUPTED", "Error code is CRC_CORRUPTED")

# Test Integer Array Packing/Unpacking
let orig_ints = [100, -500, 2048, -1, 0, 99999]
let packed_ints = bin_pack_int_array(orig_ints)
let unpacked_ints = bin_unpack_int_array(packed_ints)
assert_eq(len(unpacked_ints), 6, "Unpacked 6 integers")
assert_eq(unpacked_ints[0], 100, "Int 0 matches 100")
assert_eq(unpacked_ints[1], -500, "Int 1 matches -500")
assert_eq(unpacked_ints[2], 2048, "Int 2 matches 2048")
assert_eq(unpacked_ints[3], -1, "Int 3 matches -1")
assert_eq(unpacked_ints[5], 99999, "Int 5 matches 99999")

# ------------------------------------------------------------------------------
# PART 3: ZERO-KNOWLEDGE PROOFS & SHAMIR'S SECRET SHARING
# ------------------------------------------------------------------------------
print("\n[Phase 7] Testing Finite Field F_p Arithmetic...")
let p = 1000000007 # Standard prime

assert_eq(ff_add(10, 20, p), 30, "Field addition: (10 + 20) mod p = 30")
assert_eq(ff_sub(10, 25, p), p - 15, "Field subtraction handles underflow mod p")
assert_eq(ff_mul(100, 200, p), 20000, "Field multiplication mod p")

# Modular exponentiation: 2^10 mod p = 1024
assert_eq(ff_pow(2, 10, p), 1024, "2^10 mod p = 1024")

# Modular inverse: (a * a^-1) mod p = 1
let inv_42 = ff_inv(42, p)
let check_inv = ff_mul(42, inv_42, p)
assert_eq(check_inv, 1, "Modular inverse: (42 * 42^-1) mod p = 1")

print("\n[Phase 8] Testing Shamir's (k, n) Threshold Secret Sharing...")
let secret_val = 133742
let threshold_k = 3
let total_n = 5
let shamir_p = 2147483647 # Mersenne prime 2^31 - 1

let shares = shamir_split(secret_val, threshold_k, total_n, shamir_p, 4242)
assert_eq(len(shares), 5, "Generated 5 shares")

# Reconstruct using shares [1, 2, 3] (subset of size 3)
let subset_123 = [shares[0], shares[1], shares[2]]
let recovered_123 = shamir_reconstruct(subset_123, shamir_p)
assert_eq(recovered_123, 133742, "Reconstructed secret using shares [1, 2, 3]")

# Reconstruct using completely different shares [2, 4, 5]
let subset_245 = [shares[1], shares[3], shares[4]]
let recovered_245 = shamir_reconstruct(subset_245, shamir_p)
assert_eq(recovered_245, 133742, "Reconstructed secret using shares [2, 4, 5]")

print("\n[Phase 9] Testing Schnorr Zero-Knowledge Proof of Knowledge...")
let zkp_p = 10007 # Small prime for fast discrete log
let zkp_g = 5     # Generator
let secret_x = 73 # Prover's secret key

# Prover generates ZKP (Fiat-Shamir non-interactive proof)
let proof = schnorr_prove(secret_x, zkp_g, zkp_p, 9999)
let pub_y = proof["public_key_y"]

# Verifier verifies the ZKP without ever seeing secret_x
let zkp_ok = schnorr_verify(pub_y, proof, zkp_g, zkp_p)
assert_eq(zkp_ok, 1, "Verifier confirmed valid Zero-Knowledge Proof (knowledge of x verified)")

# Verifier rejects tampered response
let tampered_proof = {
    "commitment_r": proof["commitment_r"],
    "challenge_e": proof["challenge_e"],
    "response_s": (proof["response_s"] + 1) % (zkp_p - 1),
    "public_key_y": pub_y
}
let tampered_ok = schnorr_verify(pub_y, tampered_proof, zkp_g, zkp_p)
assert_eq(tampered_ok, 0, "Verifier rejected tampered Zero-Knowledge Proof")

test_end_suite()

print("\n==================================================================")
print("   ALL ADVANCED ACTOR, BINARY WIRE & ZKP TESTS PASSED!            ")
print("==================================================================")
