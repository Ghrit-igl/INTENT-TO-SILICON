# ==============================================================================
# AAYU Master Test Suite: System Design Architecture Primitives
# 100% Pure Self-Hosted AAYU - Zero Python, Zero C, Zero External Dependencies
# Comprehensive Verification of 20 Industrial System Design Primitives:
#   1. O(1) LRU Cache (Doubly-Linked Node Map with Sub-Microsecond Promotion)
#   2. Token Bucket Rate Limiter (High-Frequency Burst Guard)
#   3. Circuit Breaker (Cascading Failure Protection & Trial Recovery)
#   4. Consistent Hashing Ring (O(log N) Binary-Search Sharded Routing)
#   5. In-Memory Pub/Sub Event Bus (Decoupled Microservice Messaging)
#   6. Financial Idempotency Guard (Zero Double-Spend / Duplicate Charges)
#   7. Round-Robin Load Balancer (Health-Checked Worker Traffic Distributor)
#   8. Exponential Backoff with Full Jitter (AWS Anti-Thundering Herd Standard)
#   9. Bloom Filter (O(1) Probabilistic Filter with Zero False Negatives)
#  10. Sliding Window Counter Rate Limiter (Boundary-Burst-Immune Throttling)
#  11. Distributed Mutex & Lease Lock (Monotonic Fencing Tokens & TTL)
#  12. Bulkhead Concurrency Guard (Downstream Failure Isolation & Load Shedding)
#  13. Least-Connections Load Balancer (Real-Time Workload Distributor)
#  14. Singleflight (Request Coalescing to Eliminate Cache Stampedes)
#  15. XFetch (Probabilistic Early Cache Expiration - Vitter VLDB Standard)
#  16. Distributed Saga Orchestrator (Multi-Service Compensating Rollbacks)
#  17. Cluster Leader Election (Heartbeat Liveness & Automated Failover)
#  18. Dead Letter Queue & Poison Pill Isolator (Crash-Proof Message Queues)
#  19. CQRS Read-Write Database Query Router (Master-Replica Split)
#  20. Adaptive Concurrency Limiter (Netflix TCP-Vegas AIMD / Little's Law)
# ==============================================================================
import "std/test.aayu"
import "std/system.aayu"

action main()
    test_begin_suite("AAYU Native System Design Architecture Master Suite")

    # --------------------------------------------------------------------------
    # 1. O(1) LRU CACHE (Capacity 3)
    # --------------------------------------------------------------------------
    print("\n[Phase 1] Testing O(1) Doubly-Linked LRU Cache...")
    let cache = lru_cache_new(3)
    assert_eq(lru_cache_size(cache), 0, "Initial cache size is 0")

    lru_cache_put(cache, "k1", "val_1")
    lru_cache_put(cache, "k2", "val_2")
    lru_cache_put(cache, "k3", "val_3")
    assert_eq(lru_cache_size(cache), 3, "Cache is full at capacity 3")
    assert_eq(lru_cache_get(cache, "k1"), "val_1", "k1 retrieved successfully")

    # Access k1 makes k2 LRU (k1 -> k3 -> k2). Inserting k4 evicts k2.
    lru_cache_put(cache, "k4", "val_4")
    assert_eq(lru_cache_size(cache), 3, "Size stays at 3 after eviction")
    assert_true(lru_cache_get(cache, "k2") == null, "k2 was evicted as least recently used")
    assert_eq(lru_cache_get(cache, "k1"), "val_1", "k1 still exists (was promoted)")
    assert_eq(lru_cache_get(cache, "k3"), "val_3", "k3 exists")
    assert_eq(lru_cache_get(cache, "k4"), "val_4", "k4 exists")

    # --------------------------------------------------------------------------
    # 2. TOKEN BUCKET RATE LIMITER
    # --------------------------------------------------------------------------
    print("\n[Phase 2] Testing Token Bucket Rate Limiter...")
    let limiter = rate_limiter_new(3, 1)

    let req1 = rate_limiter_acquire(limiter, "client_ip_1", 1000)
    assert_eq(req1.allowed, 1, "Request 1 allowed")

    let req2 = rate_limiter_acquire(limiter, "client_ip_1", 1000)
    assert_eq(req2.allowed, 1, "Request 2 allowed")

    let req3 = rate_limiter_acquire(limiter, "client_ip_1", 1000)
    assert_eq(req3.allowed, 1, "Request 3 allowed")

    let req4 = rate_limiter_acquire(limiter, "client_ip_1", 1000)
    assert_eq(req4.allowed, 0, "Request 4 throttled (bucket empty)")

    let req5 = rate_limiter_acquire(limiter, "client_ip_1", 3000)
    assert_eq(req5.allowed, 1, "Request 5 allowed after token replenishment")

    # --------------------------------------------------------------------------
    # 3. CIRCUIT BREAKER
    # --------------------------------------------------------------------------
    print("\n[Phase 3] Testing Circuit Breaker Failure Protection...")
    let cb = circuit_breaker_new(3, 5000)
    assert_eq(cb.status, "CLOSED", "Initial circuit state is CLOSED")
    assert_eq(circuit_breaker_allow_request(cb, 1000), 1, "Requests allowed in CLOSED state")

    circuit_breaker_record_failure(cb, 1100)
    circuit_breaker_record_failure(cb, 1200)
    assert_eq(cb.status, "CLOSED", "State remains CLOSED under threshold")

    circuit_breaker_record_failure(cb, 1300)
    assert_eq(cb.status, "OPEN", "Circuit tripped to OPEN after 3 failures")
    assert_eq(circuit_breaker_allow_request(cb, 2000), 0, "Requests blocked while circuit is OPEN")

    assert_eq(circuit_breaker_allow_request(cb, 6500), 1, "Trial request permitted in HALF_OPEN")
    assert_eq(cb.status, "HALF_OPEN", "Circuit transitioned to HALF_OPEN")

    circuit_breaker_record_success(cb)
    circuit_breaker_record_success(cb)
    assert_eq(cb.status, "CLOSED", "Circuit fully healed back to CLOSED state")

    # --------------------------------------------------------------------------
    # 4. CONSISTENT HASHING RING (O(log N) Binary Search)
    # --------------------------------------------------------------------------
    print("\n[Phase 4] Testing Consistent Hashing Ring Sharding (O(log N))...")
    let ch = consistent_hash_new(3)
    consistent_hash_add_node(ch, "node_alpha")
    consistent_hash_add_node(ch, "node_beta")
    consistent_hash_add_node(ch, "node_gamma")

    let node1 = consistent_hash_get_node(ch, "user_account_101")
    let node2 = consistent_hash_get_node(ch, "user_account_202")
    let node3 = consistent_hash_get_node(ch, "user_account_303")

    assert_true(node1 != null, "Key 101 mapped to a storage node")
    assert_true(node2 != null, "Key 202 mapped to a storage node")
    assert_true(node3 != null, "Key 303 mapped to a storage node")
    assert_eq(consistent_hash_get_node(ch, "user_account_101"), node1, "Consistent hash is deterministic")

    # --------------------------------------------------------------------------
    # 5. IN-MEMORY PUB/SUB EVENT BUS
    # --------------------------------------------------------------------------
    print("\n[Phase 5] Testing Pub/Sub Message Bus...")
    let bus = event_bus_new()
    event_bus_subscribe(bus, "ORDER_PLACED", "notification_service")
    event_bus_subscribe(bus, "ORDER_PLACED", "inventory_service")
    event_bus_subscribe(bus, "PAYMENT_RECEIVED", "ledger_service")

    let delivered = event_bus_publish(bus, "ORDER_PLACED", { "order_id": 9901, "amount": 2500 })
    assert_eq(delivered, 2, "Event delivered to 2 subscribers")

    let notif_msgs = event_bus_poll(bus, "notification_service")
    assert_eq(len(notif_msgs), 1, "Notification service received 1 event")
    assert_eq(notif_msgs[0].payload.order_id, 9901, "Payload matched order 9901")

    let inv_msgs = event_bus_poll(bus, "inventory_service")
    assert_eq(len(inv_msgs), 1, "Inventory service received 1 event")
    assert_eq(len(event_bus_poll(bus, "notification_service")), 0, "Inbox cleared after poll")

    # --------------------------------------------------------------------------
    # 6. FINANCIAL IDEMPOTENCY GUARD
    # --------------------------------------------------------------------------
    print("\n[Phase 6] Testing Financial Idempotency Guard (Double-Charge Protection)...")
    let guard = idempotency_guard_new(10000)

    let first_try = idempotency_check_and_lock(guard, "idem_key_order_888", 1000)
    assert_eq(first_try.proceed, 1, "First payment request allowed to proceed")
    assert_eq(first_try.status, "LOCK_ACQUIRED", "Idempotency lock acquired")

    idempotency_commit(guard, "idem_key_order_888", { "status": "CHARGED", "receipt": "RCP_888" })

    let retry_try = idempotency_check_and_lock(guard, "idem_key_order_888", 1500)
    assert_eq(retry_try.proceed, 0, "Duplicate payment request BLOCKED from double charging")
    assert_eq(retry_try.status, "ALREADY_COMPLETED", "Cached response returned")
    assert_eq(retry_try.response.receipt, "RCP_888", "Receipt matches original transaction")

    # --------------------------------------------------------------------------
    # 7. ROUND-ROBIN LOAD BALANCER
    # --------------------------------------------------------------------------
    print("\n[Phase 7] Testing Round-Robin Load Balancer...")
    let lb = load_balancer_new()
    load_balancer_add_worker(lb, "srv-1")
    load_balancer_add_worker(lb, "srv-2")
    load_balancer_add_worker(lb, "srv-3")

    assert_eq(load_balancer_next(lb), "srv-1", "Request 1 routes to srv-1")
    assert_eq(load_balancer_next(lb), "srv-2", "Request 2 routes to srv-2")
    assert_eq(load_balancer_next(lb), "srv-3", "Request 3 routes to srv-3")
    assert_eq(load_balancer_next(lb), "srv-1", "Request 4 loops back to srv-1")
    assert_eq(load_balancer_next(lb), "srv-2", "Request 5 routes to srv-2")

    # --------------------------------------------------------------------------
    # 8. EXPONENTIAL BACKOFF WITH FULL JITTER (AWS Standard)
    # --------------------------------------------------------------------------
    print("\n[Phase 8] Testing Exponential Backoff with Full Jitter...")
    assert_eq(backoff_ceiling(0, 100, 5000), 100, "Attempt 0 ceiling is 100ms")
    assert_eq(backoff_ceiling(1, 100, 5000), 200, "Attempt 1 ceiling is 200ms")
    assert_eq(backoff_ceiling(2, 100, 5000), 400, "Attempt 2 ceiling is 400ms")
    assert_eq(backoff_ceiling(3, 100, 5000), 800, "Attempt 3 ceiling is 800ms")
    assert_eq(backoff_ceiling(10, 100, 5000), 5000, "Attempt 10 clamped to 5000ms max")

    let j_rand = backoff_with_jitter(2, 100, 5000, null)
    assert_true(j_rand >= 0, "Entropy jitter >= 0")
    assert_true(j_rand <= 400, "Entropy jitter <= 400")

    let j_seed = backoff_with_jitter(2, 100, 5000, 777)
    assert_true(j_seed >= 0, "Deterministic jitter >= 0")
    assert_true(j_seed <= 400, "Deterministic jitter <= 400")

    # --------------------------------------------------------------------------
    # 9. BLOOM FILTER (Zero False Negatives)
    # --------------------------------------------------------------------------
    print("\n[Phase 9] Testing Bloom Filter Probabilistic Membership...")
    let bf = bloom_filter_new(2048, 4)
    bloom_filter_add(bf, "txn_record_001")
    bloom_filter_add(bf, "txn_record_002")
    bloom_filter_add(bf, "txn_record_003")

    assert_eq(bloom_filter_check(bf, "txn_record_001"), 1, "txn_record_001 is present")
    assert_eq(bloom_filter_check(bf, "txn_record_002"), 1, "txn_record_002 is present")
    assert_eq(bloom_filter_check(bf, "txn_record_003"), 1, "txn_record_003 is present")
    assert_eq(bloom_filter_check(bf, "unseen_random_record_999"), 0, "Unseen record returns 0 (absent)")

    # --------------------------------------------------------------------------
    # 10. SLIDING WINDOW COUNTER RATE LIMITER
    # --------------------------------------------------------------------------
    print("\n[Phase 10] Testing Sliding Window Counter Rate Limiter...")
    let sw = sliding_window_new(2, 1000)
    let sw_r1 = sliding_window_acquire(sw, "user_mobile_99", 100)
    let sw_r2 = sliding_window_acquire(sw, "user_mobile_99", 200)
    let sw_r3 = sliding_window_acquire(sw, "user_mobile_99", 300)
    assert_eq(sw_r1.allowed, 1, "Sliding req 1 allowed")
    assert_eq(sw_r2.allowed, 1, "Sliding req 2 allowed")
    assert_eq(sw_r3.allowed, 0, "Sliding req 3 throttled (limit 2)")

    let sw_r4 = sliding_window_acquire(sw, "user_mobile_99", 1500)
    assert_eq(sw_r4.allowed, 1, "Sliding req 4 allowed smoothly in next window")

    # --------------------------------------------------------------------------
    # 11. DISTRIBUTED MUTEX & LEASE LOCK
    # --------------------------------------------------------------------------
    print("\n[Phase 11] Testing Distributed Mutex & Fencing Token Lease Lock...")
    let lm = dist_lock_manager_new()
    let lock_a = dist_lock_acquire(lm, "db_partition_asia", "worker_A", 5000, 1000)
    assert_eq(lock_a.acquired, 1, "Worker A acquired distributed lease lock")
    assert_eq(lock_a.fencing_token, 1, "Initial fencing token is 1")

    let lock_b = dist_lock_acquire(lm, "db_partition_asia", "worker_B", 5000, 1200)
    assert_eq(lock_b.acquired, 0, "Worker B rejected while lock is active")

    let renew_a = dist_lock_renew(lm, "db_partition_asia", "worker_A", 1, 2000, 1300)
    assert_eq(renew_a.renewed, 1, "Worker A successfully renewed lease")

    let rel_a = dist_lock_release(lm, "db_partition_asia", "worker_A", 1)
    assert_eq(rel_a.released, 1, "Worker A released distributed lock")

    let lock_b2 = dist_lock_acquire(lm, "db_partition_asia", "worker_B", 5000, 1400)
    assert_eq(lock_b2.acquired, 1, "Worker B acquired lock after release")
    assert_eq(lock_b2.fencing_token, 2, "Monotonic fencing token incremented to 2")

    # --------------------------------------------------------------------------
    # 12. BULKHEAD CONCURRENCY GUARD
    # --------------------------------------------------------------------------
    print("\n[Phase 12] Testing Bulkhead Concurrency Guard & Load Shedding...")
    let bh = bulkhead_new(2, 1)
    let bh_t1 = bulkhead_try_acquire(bh)
    let bh_t2 = bulkhead_try_acquire(bh)
    let bh_t3 = bulkhead_try_acquire(bh)
    let bh_t4 = bulkhead_try_acquire(bh)
    assert_eq(bh_t1.allowed, 1, "Slot 1 active")
    assert_eq(bh_t1.queued, 0, "Slot 1 not queued")
    assert_eq(bh_t2.allowed, 1, "Slot 2 active")
    assert_eq(bh_t3.allowed, 1, "Slot 3 queued in waiting buffer")
    assert_eq(bh_t3.queued, 1, "Slot 3 has queued flag")
    assert_eq(bh_t4.allowed, 0, "Slot 4 shed/rejected (concurrency and queue saturated)")

    bulkhead_release(bh)
    assert_eq(bh.queue_count, 0, "Waiting queue drained")
    assert_eq(bh.active_count, 2, "Active worker count preserved at 2")

    # --------------------------------------------------------------------------
    # 13. LEAST-CONNECTIONS LOAD BALANCER
    # --------------------------------------------------------------------------
    print("\n[Phase 13] Testing Least-Connections Dynamic Load Balancer...")
    let w_lb = weighted_lb_new()
    weighted_lb_add_worker(w_lb, "srv_east_1", 1)
    weighted_lb_add_worker(w_lb, "srv_east_2", 1)

    let req_w1 = weighted_lb_acquire_least_conns(w_lb)
    assert_eq(req_w1, "srv_east_1", "Request 1 dispatched to srv_east_1")

    let req_w2 = weighted_lb_acquire_least_conns(w_lb)
    assert_eq(req_w2, "srv_east_2", "Request 2 dispatched to srv_east_2 (least conns)")

    let req_w3 = weighted_lb_acquire_least_conns(w_lb)
    assert_eq(req_w3, "srv_east_1", "Request 3 balanced back to srv_east_1")

    weighted_lb_release(w_lb, "srv_east_2")
    let req_w4 = weighted_lb_acquire_least_conns(w_lb)
    assert_eq(req_w4, "srv_east_2", "Request 4 dynamically routed to freed srv_east_2")

    # --------------------------------------------------------------------------
    # 14. SINGLEFLIGHT (Cache Stampede Defense)
    # --------------------------------------------------------------------------
    print("\n[Phase 14] Testing Singleflight (Request Coalescing / Anti-Stampede)...")
    let sf = singleflight_new()
    let sf_call1 = singleflight_enter(sf, "trending_topic_india")
    let sf_call2 = singleflight_enter(sf, "trending_topic_india")
    let sf_call3 = singleflight_enter(sf, "trending_topic_india")

    assert_eq(sf_call1.execute, 1, "Leader request executes database fetch")
    assert_eq(sf_call2.execute, 0, "Follower 1 request coalesced into leader")
    assert_eq(sf_call3.execute, 0, "Follower 2 request coalesced into leader")

    let sf_finish = singleflight_complete(sf, "trending_topic_india", { "views": 1500000 })
    assert_eq(sf_finish.waiters_served, 2, "Served 2 waiting coalesced callers with single DB call")
    assert_eq(sf_finish.broadcast_result.views, 1500000, "Coalesced data broadcasted cleanly")

    # --------------------------------------------------------------------------
    # 15. XFETCH (Probabilistic Early Cache Expiration)
    # --------------------------------------------------------------------------
    print("\n[Phase 15] Testing XFetch Probabilistic Early Cache Refresh...")
    assert_eq(xfetch_should_refresh(0, 100, 100, null), 1, "Expired key immediately triggers refresh")
    assert_eq(xfetch_should_refresh(60, 100, 100, null), 1, "Near-expiry key (TTL 60ms <= 100ms) proactively refreshes")
    assert_eq(xfetch_should_refresh(60000, 100, 100, null), 0, "Warm key (TTL 60s) avoids unnecessary refresh")

    # --------------------------------------------------------------------------
    # 16. DISTRIBUTED SAGA ORCHESTRATOR
    # --------------------------------------------------------------------------
    print("\n[Phase 16] Testing Distributed Saga Multi-Service Orchestrator...")
    let saga = saga_new("SAGA_FLIGHT_HOTEL_BOOKING")
    saga_add_step(saga, "FLIGHT_RESERVED", "book_flight", "refund_flight")
    saga_add_step(saga, "HOTEL_RESERVED", "book_hotel", "cancel_hotel")
    saga_add_step(saga, "CAR_RENTAL", "book_car", "cancel_car")

    saga_record_step_success(saga, "FLIGHT_RESERVED")
    saga_record_step_success(saga, "HOTEL_RESERVED")

    # Car rental fails -> Must compensate Hotel then Flight in reverse order!
    let saga_rollback = saga_abort_and_compensate(saga, "CAR_RENTAL", "FLEET_DEPLETED")
    assert_eq(saga_rollback.status, "COMPENSATED", "Saga transitioned to COMPENSATED state")
    assert_eq(saga_rollback.failed_step, "CAR_RENTAL", "Failed step identified as CAR_RENTAL")
    assert_eq(len(saga_rollback.compensated_steps), 2, "2 steps rolled back")
    assert_eq(saga_rollback.compensated_steps[0], "HOTEL_RESERVED", "Compensated Hotel first (reverse order)")
    assert_eq(saga_rollback.compensated_steps[1], "FLIGHT_RESERVED", "Compensated Flight second")

    # --------------------------------------------------------------------------
    # 17. CLUSTER LEADER ELECTION
    # --------------------------------------------------------------------------
    print("\n[Phase 17] Testing Cluster Leader Election with Automated Failover...")
    let cluster = cluster_election_new(2000)
    cluster_register_node(cluster, "node_zeta")
    cluster_register_node(cluster, "node_alpha")
    cluster_register_node(cluster, "node_kappa")

    # Only node_alpha and node_kappa send heartbeats
    cluster_heartbeat(cluster, "node_alpha", 1000)
    cluster_heartbeat(cluster, "node_kappa", 1000)

    let elect1 = cluster_elect_leader(cluster, 1000)
    assert_eq(elect1.status, "NEW_LEADER_ELECTED", "New leader elected")
    assert_eq(elect1.leader, "node_alpha", "Alphabetically lowest healthy node is leader")
    assert_eq(elect1.term, 1, "Cluster term is 1")

    # While healthy, term and leader remain stable
    let elect2 = cluster_elect_leader(cluster, 1500)
    assert_eq(elect2.status, "LEADER_HEALTHY", "Leader remains healthy within timeout")

    # node_alpha crashes (stops heartbeating). At t=4000ms (timeout passed), node_kappa takes over!
    cluster_heartbeat(cluster, "node_kappa", 4000)
    let elect3 = cluster_elect_leader(cluster, 4000)
    assert_eq(elect3.status, "NEW_LEADER_ELECTED", "Automated failover triggered")
    assert_eq(elect3.leader, "node_kappa", "node_kappa elected as new leader")
    assert_eq(elect3.term, 2, "Cluster term incremented to 2")

    # --------------------------------------------------------------------------
    # 18. DEAD LETTER QUEUE (DLQ) & POISON PILL ISOLATION
    # --------------------------------------------------------------------------
    print("\n[Phase 18] Testing Dead Letter Queue (DLQ) Poison Pill Isolation...")
    let dlq = dlq_new(2)
    let fail1 = dlq_record_failure(dlq, "msg_toxic_99", { "malicious_sql": "1; DROP TABLE users;" }, "SYNTAX_VIOLATION", 1000)
    assert_eq(fail1.outcome, "RETRY_SCHEDULED", "First failure schedules retry")
    assert_eq(fail1.attempts, 1, "Attempt count is 1")

    let fail2 = dlq_record_failure(dlq, "msg_toxic_99", { "malicious_sql": "1; DROP TABLE users;" }, "SYNTAX_VIOLATION", 1100)
    assert_eq(fail2.outcome, "RETRY_SCHEDULED", "Second failure schedules retry")

    # 3rd failure exceeds max_retries (2) -> Automatically isolated into DLQ!
    let fail3 = dlq_record_failure(dlq, "msg_toxic_99", { "malicious_sql": "1; DROP TABLE users;" }, "SYNTAX_VIOLATION", 1200)
    assert_eq(fail3.outcome, "MOVED_TO_DLQ", "Poison pill isolated into Dead Letter Queue")
    assert_eq(len(dlq.dead_letters), 1, "DLQ contains 1 isolated message")
    assert_eq(dlq.dead_letters[0].msg_id, "msg_toxic_99", "DLQ record contains toxic message ID")

    # --------------------------------------------------------------------------
    # 19. CQRS READ-WRITE DATABASE QUERY ROUTER
    # --------------------------------------------------------------------------
    print("\n[Phase 19] Testing CQRS Read-Write Query Router...")
    let router = rw_router_new("aurora_primary_master")
    rw_router_add_replica(router, "read_replica_mumbai")
    rw_router_add_replica(router, "read_replica_delhi")

    let route_write = rw_router_route(router, "WRITE")
    assert_eq(route_write.target, "aurora_primary_master", "Mutation routes to Primary Master")
    assert_eq(route_write.role, "PRIMARY", "Primary role verified")

    let route_read1 = rw_router_route(router, "SELECT")
    assert_eq(route_read1.target, "read_replica_mumbai", "Read 1 routes to mumbai replica")

    let route_read2 = rw_router_route(router, "SELECT")
    assert_eq(route_read2.target, "read_replica_delhi", "Read 2 routes to delhi replica")

    # Replica mumbai goes down for maintenance
    rw_router_set_replica_health(router, "read_replica_mumbai", 0)
    let route_read3 = rw_router_route(router, "SELECT")
    assert_eq(route_read3.target, "read_replica_delhi", "Traffic automatically diverted from unhealthy replica")

    # --------------------------------------------------------------------------
    # 20. ADAPTIVE CONCURRENCY LIMITER (AIMD / Little's Law)
    # --------------------------------------------------------------------------
    print("\n[Phase 20] Testing Adaptive Concurrency Limiter (AIMD)...")
    let ac = adaptive_concurrency_new(4, 16, 50)
    assert_eq(ac.current_limit, 4, "Initial concurrency floor is 4")

    # Fast response (RTT 25ms <= 50ms) -> Additive Increase (Limit + 1)
    adaptive_concurrency_release(ac, 25)
    assert_eq(ac.current_limit, 5, "Limit additive increased to 5")

    adaptive_concurrency_release(ac, 30)
    assert_eq(ac.current_limit, 6, "Limit additive increased to 6")

    # Latency spike (RTT 180ms >> 50ms baseline) -> Multiplicative Decrease (Limit * 0.8)
    adaptive_concurrency_release(ac, 180)
    assert_eq(ac.current_limit, 4, "Congestion detected: Limit multiplicative decreased back to floor")

    # --------------------------------------------------------------------------
    # 21. WRITE-BEHIND BATCH BUFFER
    # --------------------------------------------------------------------------
    print("\n[Phase 21] Testing Write-Behind Batch Buffer...")
    let wb = write_behind_new(3, 1000)
    let wb_res1 = write_behind_add(wb, { "id": 1, "val": "tick_1" }, 100)
    assert_eq(wb_res1.status, "BUFFERED", "First write buffered")
    assert_eq(wb_res1.count, 1, "Buffer size is 1")

    let wb_res2 = write_behind_add(wb, { "id": 2, "val": "tick_2" }, 200)
    assert_eq(wb_res2.status, "BUFFERED", "Second write buffered")

    let wb_res3 = write_behind_add(wb, { "id": 3, "val": "tick_3" }, 300)
    assert_eq(wb_res3.status, "NEEDS_FLUSH", "Third write triggers batch flush")
    assert_eq(wb_res3.reason, "BATCH_SIZE_REACHED", "Reason is batch size reached")

    let flushed = write_behind_drain(wb, 300)
    assert_eq(len(flushed), 3, "Drained 3 records for bulk disk flush")
    assert_eq(len(wb.buffer), 0, "Buffer empty after flush")
    assert_eq(wb.total_flushed_count, 3, "Total flushed is 3")

    # --------------------------------------------------------------------------
    # 22. VECTOR CLOCKS (Distributed Causality & Multi-Master Conflicts)
    # --------------------------------------------------------------------------
    print("\n[Phase 22] Testing Vector Clocks Causality & Conflict Detection...")
    let vc_node_a = vector_clock_new("Node_A")
    let vc_node_b = vector_clock_new("Node_B")

    vector_clock_tick(vc_node_a)
    vector_clock_tick(vc_node_b)
    # vc_node_a has Node_A: 1, vc_node_b has Node_B: 1 -> Strictly concurrent
    let cmp1 = vector_clock_compare(vc_node_a, vc_node_b)
    assert_eq(cmp1, "CONCURRENT", "Independent ticks are concurrent")

    # Node B merges Node A's clock, then ticks
    vector_clock_merge(vc_node_b, vc_node_a)
    vector_clock_tick(vc_node_b)
    # vc_node_b now has Node_A: 1, Node_B: 1. vc_node_a has Node_A: 1.
    let cmp2 = vector_clock_compare(vc_node_a, vc_node_b)
    assert_eq(cmp2, "BEFORE", "Node A clock is strictly before Node B merged clock")

    let cmp3 = vector_clock_compare(vc_node_b, vc_node_a)
    assert_eq(cmp3, "AFTER", "Node B clock is strictly after Node A clock")

    # --------------------------------------------------------------------------
    # 23. GRACEFUL DEGRADATION ENGINE
    # --------------------------------------------------------------------------
    print("\n[Phase 23] Testing Graceful Degradation Engine (Business Tier Load Shedding)...")
    let deg = degradation_new()
    assert_eq(deg.health_status, "HEALTHY", "Initial state is HEALTHY")
    assert_eq(degradation_feature_allowed(deg, 3), 1, "Tier 3 allowed under healthy load")

    # Moderate stress: CPU 80% -> DEGRADED
    degradation_update_health(deg, 80, 50)
    assert_eq(deg.health_status, "DEGRADED", "System degraded at 80% CPU")
    assert_eq(degradation_feature_allowed(deg, 1), 1, "Tier 1 (Payments) allowed in DEGRADED")
    assert_eq(degradation_feature_allowed(deg, 2), 1, "Tier 2 (History) allowed in DEGRADED")
    assert_eq(degradation_feature_allowed(deg, 3), 0, "Tier 3 (AI/Recommendations) shed in DEGRADED")

    # Severe stress: CPU 95% -> CRITICAL
    degradation_update_health(deg, 95, 60)
    assert_eq(deg.health_status, "CRITICAL", "System critical at 95% CPU")
    assert_eq(degradation_feature_allowed(deg, 1), 1, "Tier 1 (Core Payments) stays alive in CRITICAL")
    assert_eq(degradation_feature_allowed(deg, 2), 0, "Tier 2 shed in CRITICAL")
    assert_eq(degradation_feature_allowed(deg, 3), 0, "Tier 3 shed in CRITICAL")

    # --------------------------------------------------------------------------
    # 24. REACTIVE BACKPRESSURE STREAM CONTROLLER
    # --------------------------------------------------------------------------
    print("\n[Phase 24] Testing Reactive Backpressure Stream Controller...")
    let bp = backpressure_new(2, 5)
    assert_eq(bp.is_paused, 0, "Initial stream is active (not paused)")

    # Push items up to high watermark (5)
    backpressure_push(bp, 3)
    assert_eq(bp.is_paused, 0, "Stream unpaused at depth 3")
    backpressure_push(bp, 2)
    assert_eq(bp.is_paused, 1, "High watermark reached (depth 5): Producer paused!")
    assert_eq(bp.pause_events, 1, "1 pause event recorded")

    # Consumer drains down to low watermark (2)
    backpressure_pop(bp, 3)
    assert_eq(bp.is_paused, 0, "Low watermark reached (depth 2): Producer resumed!")
    assert_eq(bp.resume_events, 1, "1 resume event recorded")

    # --------------------------------------------------------------------------
    # 25. CACHE-ASIDE INVALIDATION COORDINATOR
    # --------------------------------------------------------------------------
    print("\n[Phase 25] Testing Cache-Aside Invalidation Coordinator...")
    let ca = cache_aside_new(500)
    cache_aside_set(ca, "user_401", "Ayush", 1000)
    assert_eq(cache_aside_get(ca, "user_401", 1200), "Ayush", "Cache hit before TTL expiry")

    # Direct mutation invalidation (e.g. user updated profile in DB)
    let inv = cache_aside_invalidate(ca, "user_401")
    assert_eq(inv, 1, "Cache successfully invalidated on DB mutation")
    assert_true(cache_aside_get(ca, "user_401", 1250) == null, "Cache returns null after invalidation")

    # Natural TTL expiration test
    cache_aside_set(ca, "product_99", "Silicon Chip", 2000)
    assert_true(cache_aside_get(ca, "product_99", 2600) == null, "Cache expired after TTL elapsed")

    test_end_suite()
    print("\n==================================================================")
    print("   ALL 25 NATIVE SYSTEM DESIGN ARCHITECTURE TESTS PASSED!         ")
    print("==================================================================")
end

main()

