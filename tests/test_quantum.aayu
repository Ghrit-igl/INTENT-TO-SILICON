# ==============================================================================
# AAYU Native Quantum Computing & Circuit Simulation Test Suite
# Tests: Complex arithmetic, Unitary gates (H, X, Y, Z, S, T), Multi-qubit (CNOT, CZ, SWAP, Toffoli),
#        Bell & GHZ Entangled States, Born Measurement, Deutsch-Jozsa, Grover Search, BB84 QKD, QRNG
# ==============================================================================
import "std/test.aayu"
import "std/quantum.aayu"

test_begin_suite("AAYU Native Quantum Computing & Circuit Simulation Suite")

# ------------------------------------------------------------------------------
# Phase 1: Complex Arithmetic & Probability Densities
# ------------------------------------------------------------------------------
print("\n[Phase 1] Testing Complex Numbers & Probability Amplitudes...")

let c1 = c_new(3.0, 4.0)
let c2 = c_new(1.0, 2.0)

let c_sum = c_add(c1, c2)
assert_eq(c_sum[0], 4.0, "Complex addition real part is 4.0")
assert_eq(c_sum[1], 6.0, "Complex addition imag part is 6.0")

let c_diff = c_sub(c1, c2)
assert_eq(c_diff[0], 2.0, "Complex subtraction real part is 2.0")
assert_eq(c_diff[1], 2.0, "Complex subtraction imag part is 2.0")

# (3 + 4i)(1 + 2i) = (3 - 8) + (6 + 4)i = -5 + 10i
let c_prod = c_mul(c1, c2)
assert_eq(c_prod[0], -5.0, "Complex multiplication real part is -5.0")
assert_eq(c_prod[1], 10.0, "Complex multiplication imag part is 10.0")

# |3 + 4i|^2 = 9 + 16 = 25
let c_norm_sq = c_abs_sq(c1)
assert_eq(c_norm_sq, 25.0, "Absolute square probability density of (3+4i) is 25.0")

# ------------------------------------------------------------------------------
# Phase 2: Quantum State Vector & Single-Qubit Gates (H, X, Y, Z, S, T)
# ------------------------------------------------------------------------------
print("\n[Phase 2] Testing Quantum State Initialization & Single-Qubit Gates...")

# 1-qubit state |0>
let q1 = quantum_state_new(1)
assert_eq(len(q1), 2, "1-qubit register has 2 basis states")
let p_init = quantum_probabilities_scaled(q1, 1000)
assert_eq(p_init[0], 1000, "|0> probability is 100% (1000/1000)")
assert_eq(p_init[1], 0, "|1> probability is 0% (0/1000)")

# Apply Hadamard: |0> -> (|0> + |1>)/sqrt(2) (Equal Superposition 50/50)
let q_had = quantum_apply_h(q1, 0)
let p_had = quantum_probabilities_scaled(q_had, 1000)
assert_eq(p_had[0], 500, "After H: |0> probability is 50% (500/1000)")
assert_eq(p_had[1], 500, "After H: |1> probability is 50% (500/1000)")

# Apply H again: H(H|0>) = |0> (Reversibility of Unitary Gates)
let q_had_twice = quantum_apply_h(q_had, 0)
let p_had_twice = quantum_probabilities_scaled(q_had_twice, 1000)
assert_eq(p_had_twice[0], 1000, "H(H|0>) recovers |0> with 100% probability")
assert_eq(p_had_twice[1], 0, "H(H|0>) has 0% |1> probability")

# Apply Pauli-X: |0> -> |1> (Quantum NOT)
let q_x = quantum_apply_x(q1, 0)
let p_x = quantum_probabilities_scaled(q_x, 1000)
assert_eq(p_x[0], 0, "After X: |0> probability is 0%")
assert_eq(p_x[1], 1000, "After X: |1> probability is 100%")

# Apply Pauli-Z on |1>: inverts phase of |1> to -|1>, probability stays 100%
let q_z = quantum_apply_z(q_x, 0)
let p_z = quantum_probabilities_scaled(q_z, 1000)
assert_eq(p_z[1], 1000, "After Z on |1>: probability remains 100%")
let amp_z1 = q_z[1]
assert_eq(amp_z1[0], -1.0, "Pauli-Z flipped real phase to -1.0")

# Apply Phase S on |1>: |1> -> i|1>
let q_s = quantum_apply_s(q_x, 0)
let amp_s1 = q_s[1]
assert_eq(amp_s1[0], 0.0, "Phase S real part is 0.0")
assert_eq(amp_s1[1], 1.0, "Phase S imag part is 1.0 (pure imaginary i)")

# ------------------------------------------------------------------------------
# Phase 3: Two-Qubit Gates & Bell State Entanglement
# ------------------------------------------------------------------------------
print("\n[Phase 3] Testing Two-Qubit Gates (CNOT, CZ, SWAP) & Bell States...")

# 2-qubit register |00>
let q2 = quantum_state_new(2)
assert_eq(len(q2), 4, "2-qubit register has 4 basis states (|00>, |01>, |10>, |11>)")

# Bell State |Phi+> = (|00> + |11>) / sqrt(2)
let bell_phi_plus = quantum_bell_state(0)
let p_phi_plus = quantum_probabilities_scaled(bell_phi_plus, 1000)
assert_eq(p_phi_plus[0], 500, "Bell |Phi+>: |00> probability is 50%")
assert_eq(p_phi_plus[1], 0, "Bell |Phi+>: |01> probability is 0% (entangled)")
assert_eq(p_phi_plus[2], 0, "Bell |Phi+>: |10> probability is 0% (entangled)")
assert_eq(p_phi_plus[3], 500, "Bell |Phi+>: |11> probability is 50%")

# Bell State |Psi+> = (|01> + |10>) / sqrt(2)
let bell_psi_plus = quantum_bell_state(2)
let p_psi_plus = quantum_probabilities_scaled(bell_psi_plus, 1000)
assert_eq(p_psi_plus[0], 0, "Bell |Psi+>: |00> probability is 0%")
assert_eq(p_psi_plus[1], 500, "Bell |Psi+>: |01> probability is 50%")
assert_eq(p_psi_plus[2], 500, "Bell |Psi+>: |10> probability is 50%")
assert_eq(p_psi_plus[3], 0, "Bell |Psi+>: |11> probability is 0%")

# SWAP Gate test: initialize |01> (basis 1), swap qubits 0 and 1 -> |10> (basis 2)
let q_swap_test = quantum_state_new(2)
q_swap_test = quantum_apply_x(q_swap_test, 0) # Qubit 0 to |1> -> state |01>
q_swap_test = quantum_apply_swap(q_swap_test, 0, 1) # SWAP -> state |10>
let p_swap = quantum_probabilities_scaled(q_swap_test, 1000)
assert_eq(p_swap[1], 0, "Original basis |01> empty after SWAP")
assert_eq(p_swap[2], 1000, "Basis |10> full (1000/1000) after SWAP")

# ------------------------------------------------------------------------------
# Phase 4: Three-Qubit Gates (Toffoli CCNOT) & GHZ State Entanglement
# ------------------------------------------------------------------------------
print("\n[Phase 4] Testing Toffoli CCNOT & 3-Qubit GHZ Entanglement...")

# GHZ State: (|000> + |111>) / sqrt(2)
let ghz = quantum_ghz_state()
assert_eq(len(ghz), 8, "3-qubit register has 8 basis states")
let p_ghz = quantum_probabilities_scaled(ghz, 1000)
assert_eq(p_ghz[0], 500, "GHZ state: |000> probability is 50%")
assert_eq(p_ghz[1], 0, "GHZ state: intermediate states have 0% probability")
assert_eq(p_ghz[7], 500, "GHZ state: |111> probability is 50%")

# Toffoli Gate: Controls 0 and 1, Target 2.
# Case A: ctrl0=1, ctrl1=0, tgt=0 (|001>) -> Target NOT triggered -> stays |001>
let q_tof1 = quantum_state_new(3)
q_tof1 = quantum_apply_x(q_tof1, 0) # |001>
q_tof1 = quantum_apply_toffoli(q_tof1, 0, 1, 2)
let p_tof1 = quantum_probabilities_scaled(q_tof1, 1000)
assert_eq(p_tof1[1], 1000, "Toffoli with single control 1 does NOT flip target")

# Case B: ctrl0=1, ctrl1=1, tgt=0 (|011> = index 3) -> Target FLIPS to |111> (index 7)
let q_tof2 = quantum_state_new(3)
q_tof2 = quantum_apply_x(q_tof2, 0)
q_tof2 = quantum_apply_x(q_tof2, 1) # State is |011> (index 3)
q_tof2 = quantum_apply_toffoli(q_tof2, 0, 1, 2) # Flips qubit 2 -> index 7 (|111>)
let p_tof2 = quantum_probabilities_scaled(q_tof2, 1000)
assert_eq(p_tof2[3], 0, "Previous basis |011> vacated after Toffoli")
assert_eq(p_tof2[7], 1000, "Target qubit flipped: state is now |111> (1000/1000)")

# ------------------------------------------------------------------------------
# Phase 5: Measurement, State Vector Collapse & Expectation Values
# ------------------------------------------------------------------------------
print("\n[Phase 5] Testing Measurement Collapse & <Z> Observables...")

# Expectation value <Z> on |0> is +1.0
let q_meas = quantum_state_new(1)
let exp_z_zero = quantum_expectation_z(q_meas, 0)
assert_eq(exp_z_zero, 1.0, "<Z> observable on |0> is +1.0")

# Expectation value <Z> on |1> is -1.0
let q_meas_one = quantum_apply_x(q_meas, 0)
let exp_z_one = quantum_expectation_z(q_meas_one, 0)
assert_eq(exp_z_one, -1.0, "<Z> observable on |1> is -1.0")

# Expectation value on superposition (|0>+|1>)/sqrt(2) is 0.0
let q_super = quantum_apply_h(q_meas, 0)
let exp_z_super = quantum_expectation_z(q_super, 0)
let is_near_zero = 0
if exp_z_super < 0.001
    if exp_z_super > -0.001
        is_near_zero = 1
    end
end
assert_eq(is_near_zero, 1, "<Z> observable on equal superposition is 0.0")

# Test Born rule collapse on superposition:
let m_res = quantum_measure(q_super, 12345)
let collapsed_st = m_res["collapsed_state"]
let p_collapsed = quantum_probabilities_scaled(collapsed_st, 1000)
let is_pure = 0
if p_collapsed[0] == 1000
    is_pure = 1
end
if p_collapsed[1] == 1000
    is_pure = 1
end
assert_eq(is_pure, 1, "Measurement collapsed state into pure eigenstate")

# ------------------------------------------------------------------------------
# Phase 6: Flagship Quantum Algorithms & Security Protocols
# ------------------------------------------------------------------------------
print("\n[Phase 6] Testing Deutsch-Jozsa, Grover Search, Teleportation & BB84...")

# 1. Deutsch-Jozsa Algorithm:
let dj_const0 = quantum_deutsch_jozsa(0)
assert_eq(dj_const0, "CONSTANT", "Deutsch-Jozsa identified constant-0 function in 1 query")

let dj_const1 = quantum_deutsch_jozsa(1)
assert_eq(dj_const1, "CONSTANT", "Deutsch-Jozsa identified constant-1 function in 1 query")

let dj_bal2 = quantum_deutsch_jozsa(2)
assert_eq(dj_bal2, "BALANCED", "Deutsch-Jozsa identified balanced-identity function in 1 query")

let dj_bal3 = quantum_deutsch_jozsa(3)
assert_eq(dj_bal3, "BALANCED", "Deutsch-Jozsa identified balanced-invert function in 1 query")

# 2. Grover's Algorithm on 2 Qubits:
# Database: [0, 1, 2, 3]. Search for item 2 (|10>):
let grover_res2 = quantum_grover_2qubit(2)
assert_eq(grover_res2["target"], 2, "Grover search targeted element 2")
assert_eq(grover_res2["amplified_probability"], 1000, "Grover amplified target probability to 100% (1000/1000) in 1 step")
assert_eq(grover_res2["is_exact_match"], 1, "Grover confirmed exact match")

# Search for item 0 (|00>):
let grover_res0 = quantum_grover_2qubit(0)
assert_eq(grover_res0["amplified_probability"], 1000, "Grover amplified target 0 probability to 100% in 1 step")

# 3. Quantum Teleportation Verification:
let tele_res = quantum_teleportation_verify(0.6, 0.8)
assert_eq(tele_res["teleported"], 1, "Quantum teleportation completed")
assert_eq(tele_res["fidelity"], 100, "Quantum teleportation achieved 100% fidelity")

# 4. Quantum Key Distribution (BB84):
let bb84_clean = quantum_bb84_simulation(32, 0)
assert_eq(bb84_clean["errors"], 0, "BB84 with no eavesdropper has 0 errors")
assert_eq(bb84_clean["qber_percent"], 0, "BB84 without Eve has 0% QBER")
assert_eq(bb84_clean["secure"], 1, "BB84 channel verified SECURE")

let bb84_eavesdropped = quantum_bb84_simulation(32, 1)
let qber_high = 0
if bb84_eavesdropped["qber_percent"] >= 20
    qber_high = 1
end
assert_eq(qber_high, 1, "Eve intercepted: QBER elevated above 20%")
assert_eq(bb84_eavesdropped["secure"], 0, "Eavesdropper detected: channel flagged INSECURE")

# 5. Quantum Random Number Generator (QRNG):
let q_byte1 = quantum_qrng_byte(777)
let q_byte2 = quantum_qrng_byte(888)
let byte1_valid = 0
if q_byte1 >= 0
    if q_byte1 <= 255
        byte1_valid = 1
    end
end
assert_eq(byte1_valid, 1, "QRNG generated valid byte (0-255)")

let byte2_valid = 0
if q_byte2 >= 0
    if q_byte2 <= 255
        byte2_valid = 1
    end
end
assert_eq(byte2_valid, 1, "QRNG generated second valid byte")

test_end_suite()

print("\n==================================================================")
print("   ALL QUANTUM COMPUTING & CIRCUIT SIMULATION TESTS PASSED!       ")
print("==================================================================")
